{
  "name": "potrun-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for playing Potrun on Base",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ritt3n/potrun-sdk.git"
  },
  "homepage": "https://github.com/ritt3n/potrun-sdk#readme",
  "bugs": {
    "url": "https://github.com/ritt3n/potrun-sdk/issues"
  },
  "keywords": [
    "potrun",
    "base",
    "viem",
    "agent",
    "onchain",
    "game"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "viem": "^2.57.19",
    "vitest": "^3.2.7"
  }
}
